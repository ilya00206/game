// Prisma schema for the Telegram language learning game.
// Design rules enforced here:
//  - user progress consists of learning, a daily streak and gems

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum WordStatus {
  NEW
  LEARNING
  FAMILIAR
  KNOWN
  MASTERED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ExerciseType {
  FLASHCARD
  MULTIPLE_CHOICE
  TRANSLATION
  REVERSE
}

enum AnswerGrade {
  AGAIN
  HARD
  GOOD
  EASY
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

// ---------------------------------------------------------------------------
// User
// ---------------------------------------------------------------------------

model User {
  id         String  @id @default(cuid())
  telegramId BigInt  @unique
  username   String?
  firstName  String?
  lastName   String?

  // interface language of the bot
  language String @default("ru")
  // language the user is learning
  learningLanguage String @default("pl")
  timezone         String @default("Europe/Moscow")

  isAdmin  Boolean @default(false)
  isBanned Boolean @default(false)

  gems Int @default(0)

  // --- streak ---
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActivityDay  String? // local day key YYYY-MM-DD
  lastActivityAt   DateTime?

  // --- lifetime counters (cheap stats, always derivable from the ledger) ---
  totalAnswers         Int @default(0)
  totalCorrectAnswers  Int @default(0)
  totalSessions        Int @default(0)
  totalLearningSeconds Int @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastActiveAt DateTime @default(now())

  notificationSettings NotificationSettings?
  words                UserWord[]
  sessions             LearningSession[]
  answers              LearningAnswer[]
  dailyActivity        DailyActivity[]

  @@index([lastActiveAt])
}

model NotificationSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  notificationsEnabled  Boolean @default(true)
  dailyReminderEnabled  Boolean @default(true)
  streakReminderEnabled Boolean @default(true)
  // local time HH:mm in the user's timezone
  reminderTime          String  @default("19:00")

  lastDailyReminderDay  String?
  lastStreakReminderDay String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Content
// ---------------------------------------------------------------------------

model Word {
  id                 String     @id @default(cuid())
  language           String
  original           String
  translation        String
  pronunciation      String?
  exampleSentence    String?
  exampleTranslation String?
  audioFileId        String?
  imageFileId        String?
  difficulty         Difficulty @default(MEDIUM)
  category           String?
  tags               String[]   @default([])
  isActive           Boolean    @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userWords UserWord[]
  answers   LearningAnswer[]

  @@unique([language, original, translation])
  @@index([language, isActive])
  @@index([category])
}

model UserWord {
  id     String @id @default(cuid())
  userId String
  wordId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  word   Word   @relation(fields: [wordId], references: [id], onDelete: Cascade)

  status        WordStatus @default(NEW)
  learningLevel Int        @default(0)

  correctAnswers Int @default(0)
  wrongAnswers   Int @default(0)

  consecutiveCorrect Int @default(0)
  consecutiveWrong   Int @default(0)

  // SRS state (SM-2 compatible so the algorithm can be swapped later)
  easeFactor Float @default(2.5)
  interval   Int   @default(0) // days
  repetition Int   @default(0)
  lapses     Int   @default(0)

  lastReviewedAt DateTime?
  nextReviewAt   DateTime?
  masteredAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, wordId])
  @@index([userId, nextReviewAt])
  @@index([userId, status])
}

model LearningSession {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status SessionStatus @default(IN_PROGRESS)

  // ordered list of word ids planned for this session
  plannedWordIds String[] @default([])
  cursor         Int      @default(0)

  totalQuestions Int @default(0)
  correctAnswers Int @default(0)
  wrongAnswers   Int @default(0)

  gemsEarned Int @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  localDay    String // local day key at session start

  answers LearningAnswer[]

  @@index([userId, status])
  @@index([userId, localDay])
}

model LearningAnswer {
  id        String          @id @default(cuid())
  sessionId String
  session   LearningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId    String
  word      Word            @relation(fields: [wordId], references: [id], onDelete: Cascade)

  exerciseType   ExerciseType
  grade          AnswerGrade
  isCorrect      Boolean
  responseTimeMs Int?
  // position inside the session queue: guarantees one answer per question
  position       Int

  createdAt DateTime @default(now())

  @@unique([sessionId, position])
  @@index([userId, createdAt])
}

model DailyActivity {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  localDay String

  answers   Int @default(0)
  correct   Int @default(0)
  sessions  Int @default(0)
  seconds   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, localDay])
  @@index([userId, localDay])
}
