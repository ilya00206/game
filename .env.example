# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/lingua_quest?schema=public

# Numeric Telegram user id of the single admin
ADMIN_TELEGRAM_ID=

# --- Optional ---------------------------------------------------------------

NODE_ENV=development
LOG_LEVEL=info

# Health-check HTTP server (Railway sets PORT automatically)
PORT=3000

# Long polling (development) or webhook (production)
BOT_MODE=polling
# Public https url of the deployment, required when BOT_MODE=webhook
WEBHOOK_URL=
# Random string used as Telegram secret token for webhook verification
WEBHOOK_SECRET=

# Default locale / timezone applied to freshly created users
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LEARNING_LANGUAGE=pl

# Name / symbol of the in-game currency
CURRENCY_NAME=Кристаллы
CURRENCY_SYMBOL=💎

# Enable the personal easter-egg layer
EASTER_EGGS_ENABLED=true
